<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">

    {% include "partials/meta-info.njk" %}

    <!-- CSS -->
    <link rel="stylesheet" href="/assets/css/styles.css">

    <!-- Feed -->
    <link rel="alternate" href="/feed.xml" title="Site web template blog feed by John Mabiala" type="application/atom+xml">

    <!-- Apple icon (minimal) -->
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <!-- Scripts -->
    <script type="module" src="/assets/js/main.bundle.js"></script>

  </head>
  <body>
    {% include "partials/site-header.njk" %}
    <main id="main">
      {% block content %}
        {{ content | safe }}
      {% endblock %}
    </main>
    {% include "partials/site-footer.njk" %}
  </body>
</html>