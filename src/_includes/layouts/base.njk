<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">

    {% include "partials/meta-info.njk" %}

    <!-- CSS -->
    <link rel="stylesheet" href="/assets/css/styles.css">

    <!-- Feed -->
    <link rel="alternate" href="/feed.xml" title="Site web template blog feed by John Mabiala" type="application/atom+xml">

    <!-- Apple icon (minimal) -->
    {# <link rel="apple-touch-icon" href="/apple-touch-icon.png"> #}
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64x64.png"/>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png"/>
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png"/>

    <!-- Scripts -->
    {# <script src="https://cdn.jsdelivr.net/gh/rick-liruixin/body-scroll-lock-upgrade@v1.1.0/lib/index.umd.js" async></script> #}
    <script src="/assets/js/main.bundle.js" defer></script>

  </head>
  <body>
    {% include "partials/site-header.njk" %}
    <main id="main">
      {% block content %}
        {{ content | safe }}
      {% endblock %}
    </main>
    {% include "partials/site-footer.njk" %}
  </body>
</html>